PORT=8600
NODE_ENV=development
WEB_URL=http://localhost:8500

# Origenes extra que pueden pegarle a esta API desde un browser, separados por
# comas. El panel (WEB_URL) y el sitio publico de bookfer (bookfer.com,
# www.bookfer.com y localhost:6300) ya estan permitidos por defecto: esto es
# para sumar un staging o un dominio nuevo sin tocar codigo.
# El LeadForm del sitio publico postea desde el navegador a
# POST /public/mkt/leads, asi que si su origen no esta acá el lead se pierde.
PUBLIC_SITE_ORIGINS=

# Misma instancia MongoDB que el PMS, DB separada
MONGODB_URI=mongodb://localhost:27017/laupser_internal

# DB del PMS - lectura read-only para el modulo hotels (Fase 9).
# Mismo cluster que MONGODB_URI, distinta DB.
PMS_MONGODB_URI=mongodb://localhost:27017/elippser-sites_tests

# JWT interno (distinto al JWT del PMS)
JWT_SECRET=internal_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h

# Credenciales del super_admin. Las usan seed (para crearlo), e2e/e2eCredits
# (para loguearse) y cleanTestingData (para saber cual NO borrar). Si cambias
# la password desde /settings/users, actualiza ADMIN_PASSWORD aca tambien.
ADMIN_EMAIL=admin@bookfer.com
ADMIN_PASSWORD=ChangeMe123!

# URLs de las APIs del PMS (para integracion HTTP)
PMS_CORE_API_URL=http://localhost:9090
BOOKING_API_URL=http://localhost:7070
ROOMS_API_URL=http://localhost:4040
STAYPASS_API_URL=http://localhost:5050
# Hub Revenue (rms-app/api). Su authenticateStaff acepta AGENT_JWT_SECRET, asi
# que las tools de revenue viajan con el mismo JWT delegado que el resto.
RMS_API_URL=http://localhost:3030

# Server-to-server con el PMS — ahora es solo tag de trafico (logging/analytics),
# no autorizacion. La autorizacion real va via AGENT_JWT_SECRET.
PMS_INTERNAL_SECRET=shared_secret_here

# Identidad delegada del agente — JWT corto firmado por internal-laupser
# cuando una tool del agente pega contra pms-core/booking-app/rooms-app.
# Tiene que tener el MISMO valor exacto en los 4 servicios. Cambiar el valor
# invalida instantaneamente todos los JWTs delegados emitidos hasta el momento.
AGENT_JWT_SECRET=

# Secret para verificar el JWT del hotelero que reenvia el widget del PMS
# al crear sesion (POST /conversations/sessions con context.token). Tipicamente
# el mismo valor que JWT_SECRET de pms-core/api o el SHARED_JWT_SECRET cross-app.
SHARED_JWT_SECRET=

# Anthropic - runtime del agente (Fase 6) + cron de tickets (Fase 8)
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_AGENT_MODEL=claude-sonnet-4-6

# OpenAI (embeddings reales para RAG). Si queda vacio el runtime usa
# fallback hash-based determinista (calidad menor pero sin dependencias
# externas, util para dev).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# RAG tuning
# Spec default: 0.75 (con embeddings OpenAI). Con el fallback hash-based
# los scores son mas bajos: bajar a ~0.25 si OPENAI_API_KEY esta vacio.
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.75
RAG_TOKEN_BUDGET=2000

# Runtime conversaciones
MAX_TOOL_ITERATIONS=5
CONVERSATION_HISTORY_WINDOW=20

# --- Memoria de largo plazo del agente (estilo Claude) ---
# Destila hechos durables de las conversaciones (scoped por operativeSpace) y
# los inyecta en futuras charlas. Fire-and-forget, modelo barato. "off" lo apaga.
MEMORY_DISTILL_ENABLED=on
MEMORY_MODEL=claude-haiku-4-5-20251001

# --- Contratos: enforcement de creditos de IA ---
# Por defecto ON: una company sin contrato activo (o sin creditos en el periodo)
# queda BLOQUEADA para IA. Poner en "off" desactiva el bloqueo globalmente (util
# durante la migracion, para no cortarle la IA a companies sin contrato todavia).
# Ver internal-laupser/CONTRACTS-SPEC.md.
IA_CREDITS_ENFORCEMENT=on

# Cron del agente de pedidos
FEEDBACK_CRON_INTERVAL_HOURS=6
FEEDBACK_CRON_MIN_REQUESTS=3

# --- Intelligence Hub (lh-conectors-spec.md) ---
# Señales de demanda hotelera: vuelos, eventos, FX, feriados, clima, trends.
# FX (open.er-api.com + dolarapi), feriados (Nager.Date) y clima (Open-Meteo)
# funcionan SIN key. Los crons corren en ART; IH_CRON_DISABLED=1 los apaga y
# IH_INGEST_ON_STARTUP=0 evita la carga inicial al arrancar.

# AeroDataBox (vuelos programados). Conseguir key en rapidapi.com (buscar
# "AeroDataBox", plan free ~600 calls/mes) o api.market. Sin key el connector
# de flights reporta estado degradado y no produce señales.
AERODATABOX_API_KEY=
# 'rapidapi' (default) o 'apimarket' según dónde se sacó la key.
AERODATABOX_PROVIDER=rapidapi
# Días futuros consultados por corrida diaria. Con 4 aeropuertos y el tier
# free de AeroDataBox mantener en 2 (= ~480 calls/mes); subir con plan pago.
IH_FLIGHTS_WINDOW_DAYS=2

# Ticketmaster Discovery API (developer.ticketmaster.com, gratis,
# 5000 calls/día). Query param apikey.
TICKETMASTER_API_KEY=

# Eventbrite private token (organizador). OJO: la búsqueda pública de la API
# fue eliminada en 2020 — solo lista eventos de las organizaciones del token.
EVENTBRITE_TOKEN=

# Microservicio Python de Google Trends (internal-laupser/trends-service,
# FastAPI + trendspy). Sin esta URL el connector reporta estado degradado.
TRENDS_SERVICE_URL=http://localhost:8700

# Fuentes de eventos a deshabilitar (por sourceLabel, separadas por coma).
# Predios/agendas propias: es-ifema-madrid, ar-la-rural, ar-ba-ferial,
#   ar-mendoza-turismo, br-anhembi
# Open data oficial: fr-paris-opendata, fr-iledefrance-openagenda,
#   es-catalunya-agenda, us-nyc-parks, us-sf-our415, us-chicago-library,
#   us-chicago-choose, ar-buenosaires-agenda, uy-montevideo-agenda,
#   cl-chilecultura
# Oportunista (endpoint no contractual, tiene circuit breaker): meetup
IH_SCRAPERS_DISABLED=

# Token opcional de Socrata (data.cityofnewyork.us, data.sfgov.org, etc.).
# Gratis en el portal de cada ciudad; sin él las consultas van con throttling
# compartido, que igual alcanza para la corrida diaria.
SOCRATA_APP_TOKEN=

# Ciudades del catálogo mundial a barrer con Ticketmaster (por label exacto,
# separadas por coma). Vacío = las ~110 del catálogo. Útil para acotar el
# consumo en dev: IH_CITIES=Madrid,Buenos Aires
IH_CITIES=

# Tope de eventos que el endpoint /summary sirve al radar (default 8000).
# IH_EVENTS_SUMMARY_LIMIT=8000

# IH_CRON_DISABLED=1
# IH_INGEST_ON_STARTUP=0
# IH_EVENTS_WINDOW_DAYS=90

# --- Señales nuevas (RADAR-DEMAND-DATA-SPEC.md) ---

# Calendarios escolares vía OpenHolidays (gratis, sin key). Países ISO-2
# cubiertos por la API (Europa occidental mayormente).
# IH_SCHOOL_HOLIDAY_COUNTRIES=DE,FR,ES,IT,NL,AT,CH,BE,PT
# IH_SCHOOL_HOLIDAY_MONTHS=10

# TheSportsDB: "3" es la key de desarrollo pública (rate limit bajo). Para
# producción sacar key propia en thesportsdb.com (Patreon, barata).
# IH_THESPORTSDB_KEY=3

# Inventario de generadores de demanda (OSM Overpass, gratis sin key).
# Tiers del catálogo de ciudades a barrer (default solo tier 1) y override
# puntual por label. La primera carga se dispara a mano:
#   POST /api/v1/intelligence/ingest/venues   (o IH_VENUES_ON_STARTUP=1)
# IH_VENUES_TIERS=1
# IH_VENUES_CITIES=
# IH_VENUES_MAX_PER_CITY=250
# IH_VENUES_SUMMARY_LIMIT=5000
# IH_VENUES_ON_STARTUP=0
# IH_VENUES_MAX_RADIUS_KM=30
# IH_VENUES_DELAY_MS=5000
# Lista de endpoints con failover (la instancia principal banea bursts):
# IH_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# Feeds iCal genéricos de agendas regionales (JSON array). Ejemplo:
# IH_ICS_FEEDS=[{"label":"gijon","url":"https://…/eventos.ics","city":"Gijón","countryCode":"ES","lat":43.53,"lng":-5.66,"spreadKm":3}]

# Cruceros (cruisetimetables.com, sin key). Corrida semanal larga; primera
# carga manual: POST /api/v1/intelligence/ingest/cruises. IH_CRUISES_DETAIL=0
# baja a 1 request por puerto (sin nombres de barcos ni conteo).
# IH_CRUISES_PORTS=Buenos Aires,Ushuaia
# IH_CRUISES_WINDOW_DAYS=120
# IH_CRUISES_DETAIL=1
# IH_CRUISES_MAX_DETAIL=40

# Bandsintown: la API pública fue cerrada — pedir app_id en
# artists.bandsintown.com/support (gratis para partners). Sin key el
# connector reporta degradado y no produce señales.
# IH_BANDSINTOWN_APP_ID=
# Override del catálogo de artistas seguidos (separados por coma).
# IH_BANDSINTOWN_ARTISTS=

# Amadeus Self-Service (tarifas aéreas por corredor). Key+secret gratis en
# developers.amadeus.com; AMADEUS_ENV=production cuando aprueben la app
# (test devuelve data cacheada/limitada). Sin keys: connector degradado.
# AMADEUS_API_KEY=
# AMADEUS_API_SECRET=
# AMADEUS_ENV=test
# IH_FLIGHT_PRICE_HORIZONS=14,30,60
# IH_FLIGHT_PRICE_CURRENCY=USD

# Presión STR (InsideAirbnb, gratis sin key). Dumps trimestrales; corrida
# mensual larga — primera carga: POST /api/v1/intelligence/ingest/str-supply
# IH_STR_CITIES=Buenos Aires,Barcelona
# IH_STR_MIN_LISTINGS=5
# IH_STR_WINDOW_DAYS=150

# Alertas sanitarias WHO DON (gratis sin key), corrida diaria.
# IH_HEALTH_WINDOW_DAYS=60
# IH_HEALTH_MAX_ITEMS=40

# ───────────────────────────────────────────────────────────────────────
# Vista /global (feeds de elippser, montados en /api/global/*)
# ───────────────────────────────────────────────────────────────────────
# Todos son opcionales: cada ruta degrada sola si le falta su credencial.
# Sin ninguna, el mapa igual trae sismos, incendios, satélites, CCTV y
# noticias, que no piden clave.

# OpenSky — tráfico aéreo ADS-B. Sin credenciales cae al tier anónimo, muy
# limitado por rate limit. Alta gratuita en opensky-network.org.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AISStream — tráfico marítimo por WebSocket. Sin clave no hay capa naval.
AIS_API_KEY=

# Cloudflare Radar — cortes de internet y tráfico por país.
# OJO: este es el token de Radar (Account → Radar → Read) y NO sirve para el
# gestor de DNS de más abajo. Son dos tokens distintos a propósito.
CLOUDFLARE_API_TOKEN=

# Gemini para los endpoints /api/global/ai/*. Rota entre las claves que
# encuentre, de GEMINI_API_KEY_1 a GEMINI_API_KEY_8. Sin ninguna, el panel
# de análisis cae a un resumen sin IA.
GEMINI_API_KEY_1=

# Backend externo de RECON. Falla cerrado a propósito: mientras esté vacío,
# /api/global/scanner responde 503 y no se puede escanear desde el panel.
# SCANNER_KEY debe coincidir con el ELIPPSER_KEY de ese backend.
SCANNER_URL=
SCANNER_KEY=

# Ingesta del SDK (/api/global/sdk/ingest). También falla cerrado: sin esto
# la ingesta queda deshabilitada.
SDK_INGEST_KEY=

# Capa HOTEL INTEL del mapa: eventos, vuelos, clima, FX y feriados como
# señales de demanda. La sirve el módulo intelligence de este mismo API
# (el de las variables IH_*), así que esto apunta a sí mismo.
# Sin esto /api/global/intelligence responde 503 y la capa queda oculta.
# INTELLIGENCE_API_SECRET debe ser igual a PMS_INTERNAL_SECRET.
INTELLIGENCE_API_URL=http://localhost:8600
INTELLIGENCE_API_SECRET=

INTEL_URL=

# Webhook de GitHub para el feed de actividad del repo.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_FORWARD_URL=

# Canales de Telegram del feed OSINT, separados por coma. Vacío = default.
ELIPPSER_TELEGRAM_CHANNELS=

# --- Gateway agregador de modelos (§11.3) ---------------------------------
# Con esta clave el motor suma el catálogo completo de OpenRouter (OpenAI,
# Google, Meta, Mistral, DeepSeek, xAI...) al selector de modelos, además de
# los de Anthropic directos. Sin ella, sólo quedan los directos.
OPENROUTER_API_KEY=
# Cabeceras de atribución: OpenRouter las usa para su ranking y para poder
# correlacionar un problema de tasa o facturación del lado de ellos.
OPENROUTER_SITE_URL=https://internal.laupser
OPENROUTER_APP_TITLE=internal-laupser · motor agéntico

# Base del RMS (laupser_rms), solo lectura, para el rollup de metricas.
RMS_MONGODB_URI=
# Companies de prueba excluidas de las metricas (coma-separadas).
METRICS_EXCLUDED_COMPANY_IDS=

# Secret QUE ESPERA pms-core para lo que le entra (es su propio
# PMS_INTERNAL_SECRET, no el de este servicio). Sin esto, las llamadas de
# administracion a pms-core -- por ejemplo las reglas de bloqueo de acceso,
# USERS-ACTIONS-SPEC 20 -- vuelven 401. Ver shared/middleware/pmsProxy.ts.
PMS_CORE_INTERNAL_SECRET=

# --- Inteligencia competitiva (COMPETITIVE-INTEL-SPEC.md) ---
# Radar semanal (lunes 07:00 ART) + change watch mensual (día 2, 07:30 ART).
# CI_RADAR_CRON_DISABLED=1 apaga los dos; la config de queries vive en ci_settings (UI).
CI_RADAR_CRON_DISABLED=0
# Modelo del radar: necesita server tool web_search (no Haiku).
CI_RADAR_MODEL=claude-sonnet-4-6
# Modelo barato para extracción del borrador y resumen de cambios.
CI_DRAFT_MODEL=claude-haiku-4-5-20251001
# Modelo con web_search para buscar evidencia externa (reviews, quejas) y fallback de SPAs.
CI_EVIDENCE_MODEL=claude-sonnet-4-6
# Costo de la búsqueda web para el ledger interno (USD por 1000 búsquedas).
CI_WEB_SEARCH_USD_PER_1000=10
CI_FETCH_TIMEOUT_MS=10000
# Días sin revisión para marcar un competidor como desactualizado (también editable en ci_settings).
CI_STALE_DAYS=30
# Variante de la server tool web_search para radar/evidencia. Default (vacío) =
# web_search_20250305, la más rápida y estable para batch; "catalog" usa la que
# declara engine/llm/catalog.ts para el modelo (hoy web_search_20260209).
CI_WEB_SEARCH_TOOL_TYPE=

# --- Competencia v2: señales (COMPETITIVE-INTEL-SPEC-V2.md) ---
# Motor de señales: martes 07:00 ART (CI_SIGNALS_CRON_DISABLED=1 lo apaga). Cadencia
# por prioridad, presupuesto mensual, umbrales y webhook viven en ci_settings.signals (UI).
CI_SIGNALS_CRON_DISABLED=0
# Modelo barato para clasificar contenido (posts, release notes, cambios de página, careers, menciones).
CI_SIGNALS_MODEL=claude-haiku-4-5-20251001
# Connectors con key (gratis): sin la key el connector reporta health ok:false y la corrida lo saltea.
YOUTUBE_API_KEY=
PRODUCTHUNT_TOKEN=
# TRENDS_SERVICE_URL (ya existe arriba, intelligence-hub) alimenta el connector trends.
# Detector automático de menciones en el inbox de WhatsApp y notas del CRM: 03:30 ART.
CI_MENTION_DETECTOR_DISABLED=0
# País por defecto de las bibliotecas públicas de anuncios (ISO-2). El link de
# cada competidor usa el país de su `geoFocus` si lo tiene cargado.
CI_AD_LIBRARY_COUNTRY=AR

# --- Sitio publico (public-side/mkt-renderer) ---
# El sitio dejo de vivir en Mongo: es un repo Next y Marketing > Sitio lo edita
# como un workspace. El API necesita el filesystem del repo, asi que en un
# deploy separado hay que montarlo en un volumen compartido y apuntar aca.
# Vacio = se resuelve solo, relativo a la raiz del monorepo.
MKT_PROJECT_DIR=
# Dev server del renderer. Es lo que se embebe en la vista previa del panel.
MKT_RENDERER_URL=http://localhost:6300
# Publicar (Marketing > Sitio > Publicar). El panel escribe el repo con fs, pero
# el sitio se deploya en Coolify DESDE GitHub: sin esto se puede commitear y
# pushear, y el build hay que pedirlo a mano. Es el uuid de la aplicacion en
# Coolify (hoy la app "mkt-renderer"), y reusa COOLIFY_API_URL/COOLIFY_API_TOKEN.
MKT_COOLIFY_APP_UUID=
# Rama que Coolify tiene configurada. Publicar desde otra no cambia el sitio.
MKT_DEPLOY_BRANCH=master
# Solo para el texto de la UI ("se publico en ...").
MKT_PUBLIC_HOST=bookfer.com

# --- DNS de bookfer.com (Marketing > DNS) --------------------------------
# Gestor de la zona bookfer.com en Cloudflare. Sin token el modulo se muestra
# igual pero en estado "no configurado", con las instrucciones adentro.
#
# QUE CREAR: un **API Token** en https://dash.cloudflare.com/profile/api-tokens
# (boton "Create Token" > "Create Custom Token"). NO la Global API Key: esa da
# acceso total a la cuenta, no se puede acotar y no se puede rotar sin romper
# todo lo demas que la use.
#
#   Permissions:
#     Zone -> DNS  -> Edit    (leer y escribir registros)
#     Zone -> Zone -> Read    (resolver el zoneId y leer el estado de la zona)
#   Zone Resources:
#     Include -> Specific zone -> bookfer.com
#   TTL: sin vencimiento (o con vencimiento y lo rotas; el panel avisa)
#
# El token se ve UNA sola vez al crearlo. Es distinto del CLOUDFLARE_API_TOKEN
# de mas arriba, que es el de Radar: un token de Radar no puede tocar DNS.
CLOUDFLARE_DNS_API_TOKEN=

# Zona a administrar. Vacio = bookfer.com.
CLOUDFLARE_ZONE_NAME=bookfer.com
# Opcional: si lo seteas se saltea la resolucion por nombre (y el token puede
# ir sin Zone:Zone:Read). Esta en el Overview de la zona, abajo a la derecha.
CLOUDFLARE_ZONE_ID=

# --- Infraestructura (Sistema > Infraestructura) --------------------------
# Modulo de solo lectura que muestra los 17 servicios del stack: cual corre en
# que proveedor, con que deploy y con que dominio. Sin token el modulo abre
# igual, en estado "no configurado", con las instrucciones adentro.
#
# QUE CREAR: un Access Token en https://vercel.com/account/settings/tokens
# ("Create Token"). Vercel NO tiene tokens de solo lectura: el mismo token que
# lista proyectos puede borrarlos. Por eso el modulo no expone ni un endpoint de
# escritura, pero el token igual hay que tratarlo como una credencial critica.
#
#   Scope:      la cuenta personal (Hobby) o el equipo, segun donde vivan los
#               proyectos. Si elegis un equipo, completa tambien VERCEL_TEAM_ID.
#   Expiration: sin vencimiento, o con vencimiento y lo rotas (el panel avisa
#               cuando Vercel deja de aceptarlo).
#
# El token se ve UNA sola vez al crearlo. Verificalo con: npm run smoke:infra
VERCEL_API_TOKEN=

# Solo si los proyectos estan en un EQUIPO, no en la cuenta personal. Empieza
# con `team_` y esta en Team Settings > General. Vacio para cuenta personal:
# mandar un teamId ajeno hace que Vercel devuelva 403 en todo y parece que el
# token esta mal.
VERCEL_TEAM_ID=

# --- Coolify (mismo modulo) -----------------------------------------------
# Hoy en Coolify corren public-side/web-renderer y el trends-service. Mientras
# estas dos esten vacias, el panel muestra esos servicios con lo que dice el
# inventario y la etiqueta "sin conectar" — no inventa un estado.
#
# URL: la RAIZ de la instancia, SIN /api/v1 (https://coolify.tu-server.com).
# TOKEN: Keys & Tokens > API tokens, con permiso de lectura.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=

# --- GitHub (mismo modulo: Infraestructura > Repositorios) -----------------
# Cada app del stack es su PROPIO repositorio en la organizacion Bookfer: son 17
# repos sueltos, no un monorepo con submodulos. Con este token el panel cruza el
# commit que Vercel tiene publicado contra la cabeza de la rama de produccion y
# dice cuantos commits quedaron sin desplegar, ademas de listar los PRs abiertos.
#
# QUE CREAR: un Personal Access Token en https://github.com/settings/tokens
#
#   Fine-grained (recomendado):
#     Resource owner:  Bookfer
#     Repository access: All repositories (o las 17 elegidas a mano)
#     Permissions:  Contents      -> Read-only
#                   Metadata      -> Read-only
#                   Pull requests -> Read-only
#   Classic:
#     Scope `repo` (hace falta porque los repos son privados)
#
# El modulo es de SOLO LECTURA: no crea repos, no abre PRs y no mueve ramas.
# Que el token lo permita no es razon para exponerlo desde un panel interno.
#
# OJO: no es el mismo que GITHUB_WEBHOOK_SECRET de mas arriba. Ese valida la
# firma de los webhooks que ENTRAN; este sale a consultar la API.
GITHUB_API_TOKEN=

# Organizacion (o usuario) duenia de los repos. Vacio = Bookfer.
GITHUB_OWNER=Bookfer
